# Next server forwards same-origin /api/brainbob HTTP and SSE requests here.
# Set before starting Next (and before production builds).
BRAINBOB_API_URL=http://127.0.0.1:3001

# Optional: bypass the proxy when the browser can reach an API with matching CORS.
# NEXT_PUBLIC_BRAINBOB_API_URL=https://api.example.com
