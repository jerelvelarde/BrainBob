# Backend origin only (no path); runtime configuration, server-side only.
BRAINBOB_API_URL=http://127.0.0.1:3001

# Hosting: set the SAME strong password (16+ characters) on Vercel and backend.
# Browser login username is brainbob. Local development can leave this unset.
# BRAINBOB_DEMO_PASSWORD=

# Leave NEXT_PUBLIC_BRAINBOB_API_URL unset for the hosted, authenticated proxy.
